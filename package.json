{
  "name": "@iqkv/checkstyle-config",
  "version": "0.25.0",
  "private": true,
  "description": "Provide an optional Git commit hooks.",
  "license": "Apache-2.0",
  "author": "Dima Denisenko",
  "type": "module",
  "scripts": {
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:stylelint && pnpm formatter:check",
    "lint:stylelint": "stylelint \"**/*.css\" --aei",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@release-it/conventional-changelog": "^11.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "glob": "^13.0.6",
    "husky": "9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.22.1",
    "release-it": "^19.2.4",
    "sort-package-json": "^3.7.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsdown": "^0.21.10"
  },
  "lint-staged": {
    "*": [
      "oxfmt --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
